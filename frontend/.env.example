VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional development-only auto-login; the account must already exist in Supabase Auth.
VITE_DEV_AUTH_EMAIL=test@italk.local
VITE_DEV_AUTH_PASSWORD=replace-with-a-local-test-password
# Keep this relative during local development to use the Vite proxy.
# Set it to the deployed backend URL in production.
# VITE_API_BASE_URL=https://api.example.com/api/v1